# Root Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS LOCAL TO YOUR ENVIRONMENT.
# DO NOT COMMIT THE REAL .env FILE TO GIT.

# Backend API Keys (Server-side Only - Keep Secret)
GOOGLE_MAPS_API_KEY=your_google_maps_backend_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Database URL (SQLite default for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./unified_transit.db

# Server configuration
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174

# Client API Base URL (For Web / Mobile targeting the common backend)
VITE_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
